PORT=3000
SITE_URL=https://www.sourcetx.com
ADMIN_USER=admin
ADMIN_PASSWORD=replace-with-a-long-random-password
# Email alerts: NOTIFY_EMAIL receives an email for every new application,
# contact message, talent request, and newly posted job.
# Use Gmail or any free SMTP provider (Brevo, SendGrid, Mailgun, etc.).
# Gmail: enable 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and put it in SMTP_PASS.
# NOTIFY_EMAIL=yourname@gmail.com
NOTIFY_EMAIL=info@sourcetx.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=yourname@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=yourname@gmail.com
# MySQL is optional. When all DB_* variables below are set and reachable,
# applications, messages, talent requests, and chat captures are stored in MySQL.
# Otherwise the site falls back to JSON files in the data/ directory.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
# STORAGE_PATH=/absolute/persistent/storage/path
# Job Sync auto-close: postings tracked via Job Sync (manual or bulk import)
# are auto-closed when they are not refreshed within this many days.
JOB_STALE_DAYS=60
# Visitor chat assistant: the knowledge base is data/chatbot.json (edit the
# intents and answers there; no API key or extra configuration required).
# Unanswered chat questions are captured in the admin panel and alerted to
# NOTIFY_EMAIL (see above).
